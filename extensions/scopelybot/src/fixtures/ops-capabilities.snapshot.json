      "name": "identity.users.list",
      "summary": "Find native users by AND search terms across username/email/first/last name; optional is_active and organization_id. Global platform-support scope, active platform admin only. Includes inactive targets. Native IDs and membership facts; native_user_role is not an effective grant. No legacy role, session counts/history, lockout state or write eligibility. Pages: limit 1-50 (default 25), offset 0-2147483647; follow next_offset until null. Whole rows may reduce page size to fit 12000 escaped JSON bytes; oversized header/row refuses.",
      "untrusted_output": true,
      "wire_name": "identity-users-list"
    },
    {
      "effect": "read",
      "family": "pricing",
      "input_schema": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "scope_mode": {
                  "const": "all"
                }
              },
              "required": [
                "scope_mode"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "scope_category"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "scope_mode": {
                  "const": "exact"
                }
              },
              "required": [
                "scope_mode"
              ]
            },
            "then": {
              "required": [
                "scope_category"
              ]
            }
          }
        ],
        "properties": {
          "category": {
            "maxLength": 100,
            "type": "string"
          },
          "is_active": {
            "type": "boolean"
          },
          "limit": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "offset": {
            "minimum": 0,
            "type": "integer"
          },
          "scope_category": {
            "description": "Exact stored scope; empty means unclassified. Forbidden with scope_mode=all.",
            "maxLength": 16,
            "type": "string"
          },
          "scope_mode": {
            "enum": [
              "all",
              "exact"
            ],
            "type": "string"
          },
          "vendor_key": {
            "maxLength": 50,
            "minLength": 1,
            "pattern": "^[-a-zA-Z0-9_]+$",
            "type": "string"
          }
        },
        "required": [
          "vendor_key"
        ],
        "type": "object"
      },
      "max_items": 100,
      "name": "pricing.defaults.list",
      "summary": "The platform default rates for one vendor: the governing rate card's entries (amounts as strings) with the card's version and effective window. Use scope_mode=all without scope_category for every scope, or scope_mode=exact with scope_category (empty matches unclassified rows). A scope_category without scope_mode retains exact matching. Optional filters: category, is_active. Paged: limit 1-100 (default 50) and offset; total is the full count and next_offset the next page's offset (null on the last page). Staff only. These are VIP native rates. The older ZW pricing table is separate and is not changed by the bot.",
      "untrusted_output": false,
      "wire_name": "pricing-defaults-list"
    },
    {
      "effect": "read",
      "family": "sessions",
      "input_schema": {
        "additionalProperties": false,
        "maxProperties": 1,
        "minProperties": 1,
        "properties": {
          "order_number": {
            "description": "The deal's minted order number, e.g. PS-0000123.",
            "maxLength": 20,
            "pattern": "^PS-[0-9]{1,17}$",
            "type": "string"
          },
          "session_id": {
            "description": "The deal's envelope id (sessions.list `id`). Not an order number and not a legacy /api/v1/orders id (those overlap in value).",
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "max_items": 200,
      "name": "sessions.get",
      "summary": "One deal for platform staff, by exactly one of session_id (the id of a sessions.list row) or order_number (PS-NNNNNNN). Answer keys only, no values.",
      "untrusted_output": true,
      "wire_name": "sessions-get"
    },
    {
      "effect": "read",
      "family": "sessions",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "organization_id": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          },
          "page": {
            "maximum": 10000,
            "minimum": 1,
            "type": "integer"
          },
          "page_size": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "search": {
            "maxLength": 100,
            "type": "string"
          },
          "status": {
            "items": {
              "enum": [
                "archived",
                "cancelled",
                "closed",
                "declined",
                "draft",
                "in_progress",
                "locked",
                "pricing_complete",
                "signed",
                "sow_generated",
                "sow_sent",
                "voided"
              ],
              "type": "string"
            },
            "maxItems": 12,
            "type": "array",
            "uniqueItems": true
          }
        },
        "type": "object"
      },
      "max_items": 100,
      "name": "sessions.list",
      "summary": "Account-wide deal list for platform staff, newest first, paged. Filters: search (company, order number, organization name), status (module vocabulary), organization_id. Read one with sessions.get by its id.",
      "untrusted_output": true,
      "wire_name": "sessions-list"
    },
