{
  "about": "Canonical Zoom user id test vectors, shared by the zoomwarriors kernel (apps.authentication.journey_models.normalize_zoom_user_id) and the scopelybot plugin. Both sides must agree on every row.",
  "rules": [
    "trim ASCII whitespace only (space, \\t, \\n, \\r, \\f, \\v) at both ends; nothing else is trimmed",
    "if the last 13 characters are ASCII and equal '@xmpp.zoom.us' ignoring ASCII case, drop them (once)",
    "the rest must be ASCII; lower-case it",
    "it must then fully match ^[a-z0-9_-]{6,64}$, else the value is malformed"
  ],
  "classes": {
    "valid": "canonical is the id to send / look up",
    "empty": "nothing after trimming: the header is absent (kernel status missing)",
    "malformed": "not a Zoom id (kernel status unmapped, detail: not a valid Zoom user id)",
    "multiple": "contains ',': more than one value (kernel status ambiguous); checked before the shape"
  },
