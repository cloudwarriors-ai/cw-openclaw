{
  "id": "scopelybot",
  "name": "ScopelyBot",
  "description": "Scopely VIP observability and break/fix agent tools",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "scopelyRepos": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [
          "cloudwarriors-ai/scopely"
        ],
        "description": "GitHub repos scoped for Scopely issue management"
      },
      "serviceContainers": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Exact Docker container names Scopely support tools may inspect"
      },
      "writeApproverIds": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Exact Zoom sender ids allowed to execute staged Scopely writes"
      }
    }
