# Copy to .env and fill with your credentials

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Must be a WhatsApp-enabled Twilio number, prefixed with whatsapp:
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX

# Docker compose required vars
CLAWDBOT_CONFIG_DIR=/root/.clawdbot
CLAWDBOT_WORKSPACE_DIR=/root/clawd
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENROUTER_API_KEY=sk-or-v1-...
OPENAI_API_KEY=sk-proj-...

# GitHub 2FA OAuth
GITHUB_2FA_CLIENT_ID=
GITHUB_2FA_CLIENT_SECRET=

# ngrok
NGROK_AUTH_TOKEN=
NGROK_DOMAIN=

# Project Pulse
PROJECT_PULSE_URL=https://projectpulse.pscx.ai
PROJECT_PULSE_EMAIL=
PROJECT_PULSE_PASSWORD=

# Scopely VIP (scopelybot)
# Prod: https://vip.pscx.ai   Dev: https://dev.vip.pscx.ai
# SCOPELY_BASE_URL is the canonical name; SCOPELY_URL is kept as a backwards-compat alias.
# SCOPELY_EMAIL / SCOPELY_PASSWORD authenticate via the Next.js BFF cookie flow
#   (POST /api/auth/login/ → access_token / refresh_token cookies → replayed on every call).
#   Use a dedicated bot user, not a human account.
# SCOPELY_CONTAINER is the Docker container name on the host running the devtools-api
# sidecar — used for `scopely_correlate_errors` log search.
SCOPELY_BASE_URL=https://vip.pscx.ai
SCOPELY_EMAIL=
SCOPELY_PASSWORD=
SCOPELY_CONTAINER=scopely-scopely-backend-1
# Bot-specific devtools-api override. Falls back to shared DEVTOOLS_API_URL/DEV_TOOLS_API.
# Set to https://devtools-api.cloudwarriors.ai (+ prod token) to query prod scopely logs
# without changing the shared sidecar that other bots use.
SCOPELY_DEVTOOLS_API_URL=
SCOPELY_DEV_TOOLS_API=

# ZW integration required vars
ZW2_URL=https://dev2.api.zoomwarriors.com
ZW2_USERNAME=
ZW2_PASSWORD=

# Gateway auth token (no default — compose passes it straight through; the
# consuming code fails closed when unset).
OPENCLAW_GATEWAY_TOKEN=

# Tesseract ETL backend. No prod fallback: unset = tesseract tools disabled.
# Internal URL example: http://playground-backend:8000
# External (browser-accessible) URL example: http://localhost:8130
TESSERACT_URL=
TESSERACT_EXTERNAL_URL=
TESSERACT_USERNAME=
TESSERACT_PASSWORD=

# Bighead avatar API (BIGHEAD_API_URL defaults to the compose-internal
# http://bighead:8000; the token has NO default — join tool fails closed).
BIGHEAD_GATEWAY_TOKEN=

# Confirm-gate channel bindings (Zoom channel JIDs). Each bot posts its
# CONFIRM <code> prompt to its channel and only a reply FROM that channel can
# fire the staged write. Unset = write staging disabled for that bot.
SCOPELYBOT_ZOOM_CHANNEL=
BIGHEADBOT_ZOOM_CHANNEL=
PULSEBOT_ZOOM_CHANNEL=
ZWS_ZOOM_CHANNEL=
CF_ZOOM_CHANNEL=
EOA_ZOOM_CHANNEL=

# Zoom S2S OAuth (Team Chat App)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=
ZOOM_BOT_JID=
ZOOM_WEBHOOK_SECRET_TOKEN=

# Zoom S2S OAuth (Admin Reports — for chat history ingest)
# Create at marketplace.zoom.us → Build App → Server-to-Server OAuth
# Scopes needed: report:read:admin, chat_message:read:admin
ZOOM_REPORT_ACCOUNT_ID=${ZOOM_ACCOUNT_ID}
ZOOM_REPORT_CLIENT_ID=
ZOOM_REPORT_CLIENT_SECRET=
ZOOM_REPORT_USER=

ADMIN_DOMAIN=cloudwarriors.ai
ZOOM_PREFILTER_MODEL=anthropic/claude-haiku-4.5

DEV_TOOLS_API=
DEVTOOLS_API_URL=

NEXT_PUBLIC_GITHUB_BOT_API_URL=
GITHUB_BOT_API_URL=
GITHUB_BOT_API_SECRET=
GITHUB_BOT_WEBHOOK_SECRET=
ADMIN_USERS=

# Secrets parameterized out of docker-compose.dev.yml (2026-06-04).
# On the deploy host these must be set in .env; compose no longer hardcodes
# them and the template carries NO real values (2026-06-09).
PEA_RELAY_TOKEN=
DEA_ES_PASSWORD=
DEVTOOLS_LOCAL_KEY=
